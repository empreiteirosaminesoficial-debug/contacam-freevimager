IDR_MAINFRAME MENU
BEGIN
    POPUP "&Arquivo"
    BEGIN
        MENUITEM "Novo...",                      ID_FILE_NEW
        MENUITEM "&Abrir Arquivo...\tCtrl+O",       ID_FILE_OPEN
        MENUITEM "Abrir &Pasta...",                ID_FILE_OPEN_DIR
        MENUITEM SEPARATOR
        POPUP "Digitalizar"
        BEGIN
            MENUITEM "Digitalizar Único",                 ID_FILE_ACQUIRE
            MENUITEM "Digitalizar para Tiff",                ID_FILE_ACQUIRE_TO_TIFF
            MENUITEM SEPARATOR
            MENUITEM "Digitalizar para Pdf",                 ID_FILE_ACQUIRE_TO_PDF
            MENUITEM "Digitalizar para Pdf && Email",        ID_FILE_ACQUIRE_AND_EMAIL
            MENUITEM SEPARATOR
            MENUITEM "S&elecionar Origem",              ID_FILE_SELECTTWAINSOURCE
        END
        MENUITEM "Email",                       ID_FILE_SENDMAIL_OPEN_DOCS
        MENUITEM "Processamento em Lote...",         ID_FILE_SHRINK_DIR_DOCS
        MENUITEM SEPARATOR
        MENUITEM "Arquivo Recente",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM "Limpar Lista",                  ID_FILE_MRU_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "Sa&ir",                       ID_APP_EXIT
    END
    POPUP "&Editar"
    BEGIN
        MENUITEM "C&olar\tCtrl+V",              ID_EDIT_PASTE
        MENUITEM "Captura de Tela\tCtrl+F11",        ID_EDIT_SCREENSHOT
    END
    POPUP "&Câmera"
    BEGIN
        MENUITEM "&Rede / Câmera IP",        ID_CAPTURE_NETWORK
        MENUITEM SEPARATOR
        MENUITEM "&Remover Câmeras",             ID_EDIT_DELETE
    END
    POPUP "&Configurações"
    BEGIN
        MENUITEM "Configurações Globais",             ID_FILE_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "Registro Normal",              ID_SETTINGS_LOG_NORMAL
        MENUITEM "Registro Detalhado",             ID_SETTINGS_LOG_VERBOSE
