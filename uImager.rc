    LTEXT           "seg",IDC_STATIC2295,236,241,15,8
    PUSHBUTTON      "Para\nAssunto\nServidor",IDC_SENDMAIL_CONFIGURE,361,211,45,40,BS_MULTILINE
    PUSHBUTTON      "OK",IDOK,152,262,56,16,BS_MULTILINE
    PUSHBUTTON      "Cancelar",IDCANCEL,221,262,56,16
END

IDD_RENAME DIALOGEX 0, 0, 186, 47
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Renomear"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,42,26,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,97,26,50,14
    EDITTEXT        IDC_EDIT_FILENAME,7,7,172,12,ES_AUTOHSCROLL
END

IDD_DELETE_CAM_FOLDERS DIALOGEX 0, 0, 258, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Selecione as Câmeras a Remover"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LISTBOX         IDC_CAM_FOLDERS,7,7,244,162,LBS_MULTIPLESEL | LBS_USETABSTOPS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Excluir",IDOK,7,177,50,18
    PUSHBUTTON      "Cancelar",IDCANCEL,68,177,50,18
    PUSHBUTTON      "Selecionar Tudo",IDC_BUTTON_LIST_SELECTALL,140,177,50,18
    PUSHBUTTON      "Selecionar Nenhum",IDC_BUTTON_LIST_SELECTNONE,201,177,50,18
END

IDD_PLATERECOGNIZER DIALOGEX 0, 0, 227, 182
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Plate Recognizer"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         "Plate Recognizer oferece planos GRATUITOS com reconhecimento de placas de alta precisão em mais de 60 países <a>(?)</a>",IDC_SYSLINK_PLATERECOGNIZER_HELP,
                    "SysLink",WS_TABSTOP,7,6,214,27
    CONTROL         "API em Nuvem",IDC_CHECK_PLATERECOGNIZER_CLOUD,"Button",BS_AUTORADIOBUTTON | WS_GROUP,7,38,85,10
    CONTROL         "SDK Local",IDC_CHECK_PLATERECOGNIZER_ONPREMISE,
                    "Button",BS_AUTORADIOBUTTON,7,72,82,10
    EDITTEXT        IDC_EDIT_PLATERECOGNIZER_TOKEN,42,51,179,13,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_PLATERECOGNIZER_URL,42,86,179,13,ES_AUTOHSCROLL
    LTEXT           "Regiões (opcional)",IDC_STATIC,7,110,68,8
    EDITTEXT        IDC_EDIT_PLATERECOGNIZER_REGIONS,7,121,214,13,ES_AUTOHSCROLL
    CONTROL         "Código de país de 2 letras separado por espaço: gb de it fr\nEUA e Austrália podem incluir o estado: us-ca au-qld <a>(?)</a>",IDC_SYSLINK_PLATERECOGNIZER_REGIONS_HELP,
                    "SysLink",WS_TABSTOP,7,136,214,21
    DEFPUSHBUTTON   "OK",IDOK,57,163,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,120,163,50,14
    LTEXT           "Token",IDC_STATIC,18,53,22,8
    LTEXT           "Url",IDC_STATIC,18,88,15,8
END


