IDD_BATCH_PROC_GENERALTAB DIALOGEX 0, 0, 226, 78
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    COMBOBOX        IDC_COMBO_EXTENSION,6,4,214,94,CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "Ajuste da Data de Captura",IDC_CHECK_EXIF_TIMEOFFSET,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,22,70,10
